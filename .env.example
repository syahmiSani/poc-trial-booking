# Copy to .env — every value here is safe to commit and safe to share.
DATABASE_URL=postgres://ottodot:ottodot@localhost:55432/ottodot

# ---------------------------------------------------------------------------
# Booking behaviour
# ---------------------------------------------------------------------------
# How long a seat is held while the parent is in checkout.
HOLD_TTL_SECONDS=600

# ---------------------------------------------------------------------------
# TEST-ONLY KNOBS — never set these to anything but the defaults in production.
# They exist so a human can reproduce a millisecond-scale race by hand.
# ---------------------------------------------------------------------------
# Injects a sleep between the capacity read and the seat write, widening the
# race window so two browser tabs can genuinely collide. 0 = disabled.
RACE_WINDOW_MS=0

# safe  = atomic conditional UPDATE + CHECK constraint (the real implementation)
# naive = SELECT COUNT(*) then INSERT (the textbook bug, kept so the test suite
#         can be shown going red against it)
BOOKING_STRATEGY=safe

# ---------------------------------------------------------------------------
# Mock payment provider
# ---------------------------------------------------------------------------
MOCK_PROVIDER_URL=http://localhost:3000/mock-provider
PAYMENT_WEBHOOK_SECRET=dev_only_not_a_real_secret
PAYMENT_PROVIDER_LATENCY_MS=0
