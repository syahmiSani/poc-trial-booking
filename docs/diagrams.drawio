="1260" dy="545" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="545" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="m1h" value="A · Testing console" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="60" width="220" height="40" as="geometry"/></mxCell><mxCell id="m1" value="One click per scenario&lt;br&gt;Proves: every case, narrated&lt;br&gt;Start here" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=10;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="m2h" value="B · Two browser tabs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="280" y="60" width="220" height="40" as="geometry"/></mxCell><mxCell id="m2" value="Overlap from the 10-min hold&lt;br&gt;Proves: the product flow&lt;br&gt;Human, no tooling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=10;" vertex="1" parent="1"><mxGeometry x="280" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="m3h" value="C · RACE_WINDOW_MS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="520" y="60" width="220" height="40" as="geometry"/></mxCell><mxCell id="m3" value="Overlap from a forced sleep&lt;br&gt;Proves: the race is real&lt;br&gt;Visible to a human" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=10;" vertex="1" parent="1"><mxGeometry x="520" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="m4h" value="D · 20 clients at once" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="760" y="60" width="220" height="40" as="geometry"/></mxCell><mxCell id="m4" value="Overlap in the same instant&lt;br&gt;Proves: 1 winner of 20&lt;br&gt;Stress backstop" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=10;" vertex="1" parent="1"><mxGeometry x="760" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="m5h" value="E · The test suite" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1000" y="60" width="220" height="40" as="geometry"/></mxCell><mxCell id="m5" value="Overlap plus assertions&lt;br&gt;Proves: it stays true&lt;br&gt;npm test, CI gate" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1000" y="100" width="220" height="100" as="geometry"/></mxCell><mxCell id="inv" value="Invariant: at most one confirmed booking for the last seat&lt;br&gt;and nobody is charged for a seat they did not get" style="rounded=1;whiteSpace=wrap;html=1;arcSize=50;fillColor=#E3F4E9;strokeColor=#3B8F5A;fontColor=#1F2A37;fontSize=13;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="340" y="330" width="560" height="90" as="geometry"/></mxCell><mxCell id="nt" value="Each one is also run with BOOKING_STRATEGY=naive, where it must fail." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBE6;strokeColor=#C9B458;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="450" width="560" height="55" as="geometry"/></mxCell><mxCell id="fig4c_test_methods_e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44536B;fontColor=#5B6673;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150" y="200" as="sourcePoint"/><mxPoint x="340" y="375" as="targetPoint"/><Array as="points"><mxPoint x="150" y="375"/></Array></mxGeometry></mxCell><mxCell id="fig4c_test_methods_e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44536B;fontColor=#5B6673;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="390" y="200" as="sourcePoint"/><mxPoint x="390" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="fig4c_test_methods_e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44536B;fontColor=#5B6673;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="630" y="200" as="sourcePoint"/><mxPoint x="630" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="fig4c_test_methods_e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44536B;fontColor=#5B6673;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="870" y="200" as="sourcePoint"/><mxPoint x="870" y="330" as="targetPoint"/></mxGeometry></mxCell><mxCell id="fig4c_test_methods_e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44536B;fontColor=#5B6673;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1110" y="200" as="sourcePoint"/><mxPoint x="900" y="375" as="targetPoint"/><Array as="points"><mxPoint x="1110" y="375"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram name="4d. Zero-trust reproduction - two psql sessions" id="fig4d_psql"><mxGraphModel dx="980" dy="660" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="980" pageHeight="660" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="h1" value="psql session 1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="100" y="40" width="300" height="50" as="geometry"/></mxCell><mxCell id="h2" value="psql session 2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E8EDF3;strokeColor=#44536B;fontColor=#1F2A37;fontSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="40" width="300" height="50" as="geometry"/></mxCell><mxCell id="l1" value="" style="shape=line;direction=north;strokeColor=#A9B2BD;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="249" y="90" width="2" height="500" as="geometry"/></mxCell><mxCell id="l2" value="" style="shape=line;direction=north;strokeColor=#A9B2BD;dashed=1;html=1;" vertex="1" parent="1"><mxGeometry x="749" y="90" width="2" height="500" as="geometry"/></mxCell><mxCell id="s1a" value="BEGIN;&lt;br&gt;UPDATE ... WHERE seats_taken &lt; capacity&lt;br&gt;→ UPDATE 1" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="300" height="75" as="geometry"/></mxCell><mxCell id="s2a" value="BEGIN;  the same UPDATE" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="235" width="300" height="50" as="geometry"/></mxCell><mxCell id="s2b" value="BLOCKED on the row lock" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#FDE8E7;strokeColor=#C0392B;fontColor=#1F2A37;fontSize=11;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="600" y="305" width="300" height="50" as="geometry"/></mxCell><mxCell id="s1b" value="COMMIT;" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="100" y="400" width="300" height="50" as="geometry"/></mxCell><mxCell id="s2c" value="unblocks · re-evaluates WHERE against&lt;br&gt;the committed row  →  UPDATE 0" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="470" width="300" height="75" as="geometry"/></mxCell><mxCell id="s2d" value="COMMIT;  no seat taken" style="rounded=1;whiteSpace=wrap;html=1;arcSize=8;fillColor=#EAF2FB;strokeColor=#2F6FB5;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="600" y="565" width="300" height="45" as="geometry"/></mxCell><mxCell id="nt" value="READ COMMITTED: an UPDATE that blocks on a row lock re-checks its WHERE clause against the newly committed row. That is the entire guarantee, and it needs none of my application code to demonstrate." style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFBE6;strokeColor=#C9B458;fontColor=#1F2A37;fontSize=11;" vertex="1" parent="1"><mxGeometry x="60" y="480" width="470" height="110" as="geometry"/></mxCell><mxCell id="fig4d_psql_e0" value="lock released" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;strokeColor=#44536B;fontColor=#5B6673;fontSize=11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="400" y="425" as="sourcePoint"/><mxPoint x="600" y="507" as="targetPoint"/><Array as="points"><mxPoint x="565" y="425"/><mxPoint x="565" y="507"/></Array></mxGeometry></mxCell></root></mxGraphModel></diagram></mxfile>